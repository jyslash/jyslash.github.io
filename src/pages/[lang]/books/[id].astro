---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NotTranslated from '../../../components/NotTranslated.astro';
import { getItems, type Item } from '../../../lib/archive';
import { formatDate, parseDate } from '../../../lib/dates';
import { LANGS, t } from '../../../lib/i18n';
import { media } from '../../../lib/media';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const item of await getItems('books', lang)) {
      paths.push({ params: { lang, id: item.id }, props: { item } });
    }
  }
  return paths;
}

const { item } = Astro.props as { item: Item<'books'> };
const { lang, data } = item;
const Content = item.bodyEntry ? (await render(item.bodyEntry)).Content : null;
const started = parseDate(data.started);
const finished = parseDate(data.finished);
---

<Base lang={lang} section="books" title={data.title}>
  <div class="posts-feed">
    <article class="feed-post">
      <div class="feed-post-date entry-meta">
        {started && <span>{t(lang, 'kind.bookStarted')} {formatDate(started, lang)}</span>}
        {finished && <span>{t(lang, 'kind.bookFinished')} {formatDate(finished, lang)}</span>}
      </div>
      <div class="feed-post-content">
        <h1 class="feed-post-title" transition:name={`book-title-${item.id}`}>{data.title}</h1>
        <p class="book-author entry-byline">{data.author}</p>
        {data.cover && <div class="book-cover book-cover--large" transition:name={`book-cover-${item.id}`}><img src={media(data.cover)} alt="" /></div>}
        {!item.translated && <NotTranslated lang={lang} />}
        {data.note && <p class="book-note">{data.note}</p>}
        {Content && <div class="feed-post-body post-body"><Content /></div>}
      </div>
    </article>
  </div>
</Base>
